# Complete deployment configuration. Copy to .env (mode 600) before Compose use.
# Change values in .env, not docker-compose.yml. Never commit real credentials.
# Each service receives only its explicitly mapped variables from Compose.

# Deployment and GPU visibility
# Installer deploys to /opt/ai-stack and writes the detected GPU target.
AI_STACK_ROOT=/opt/ai-stack
# Used in public URLs and the installer-generated certificate, not a bind address.
PUBLIC_IP_OR_DOMAIN=localhost
# Device selection for AMD containers; HIP_VISIBLE_DEVICES below selects within
# ComfyUI. Check probe index ordering separately when exposing multiple GPUs.
AMD_VISIBLE_DEVICES=all
ROCM_GFX_TARGETS=gfx1201

# Credentials: installer replaces these examples with random values.
# Manual setup: replace credentials, and synchronize LLAMA_CPP_API_KEY with
# config/llama-cpp/api-key.txt. HF_TOKEN is optional unless a model requires it.
HF_TOKEN=
LLAMA_CPP_API_KEY=
GRAFANA_ADMIN_PASSWORD=
SEARXNG_SECRET=
# Required for both services; installer generates a key when empty.
OPEN_TERMINAL_API_KEY=
# Persistent session/encryption key; installer generates it when empty.
# Existing deployments: retain the current Open WebUI key before upgrading.
WEBUI_SECRET_KEY=

# llama.cpp build and inference (use a tested commit/tag for reproducibility)
LLAMA_CPP_REF=master
# Maximum simultaneously loaded models on the main router; higher values need VRAM.
LLAMA_CPP_MODELS_MAX=1
# Offloading applies to BOTH llama.cpp services in the current Compose file.
LLAMA_CPP_GPU_LAYERS=all
# Concurrent requests per main-router model (shared by all users).
LLAMA_CPP_PARALLEL=2
# Total context budget; with 2 fixed slots, 65536 gives 32768 tokens per slot.
# Larger contexts increase KV-cache memory consumption.
LLAMA_CPP_CTX_SIZE=65536
# Logical prompt batch and physical microbatch sizes; reducing them may lower
# peak prompt-processing memory at the cost of throughput.
LLAMA_CPP_BATCH_SIZE=2048
LLAMA_CPP_UBATCH_SIZE=512
# Downloads finish before startup; this grace period covers router startup.
LLAMA_CPP_HEALTH_START_PERIOD=5m

# Dedicated image-prompt server (Qwen3.5-4B Q4_K_M); shares GPU offload settings.
LLAMA_CPP_IMAGE_CTX_SIZE=16384
# CPU threads for token generation and prompt processing on this service.
# Its logical batch size uses the shared LLAMA_CPP_BATCH_SIZE setting.
LLAMA_CPP_IMAGE_THREADS=8

# ComfyUI build and runtime
COMFYUI_ROCM_PYTORCH_IMAGE=rocm/pytorch:rocm10.0_ubuntu26.04_py3.14_pytorch_release_2.13.0
# ComfyUI always resolves the latest stable release during Compose builds.
# Use a commit SHA to pin bundled GGUF custom nodes.
COMFYUI_GGUF_REF=main
# Host TLS port on NGINX; internal ComfyUI port remains 8188.
COMFYUI_HTTPS_PORT=8444
# /dev/shm capacity inside the container; this is not a VRAM allocation limit.
COMFYUI_SHM_SIZE=32gb
COMFYUI_HIP_VISIBLE_DEVICES=0

# Open Terminal (pin a tested image tag for reproducible upgrades)
OPEN_TERMINAL_VERSION=latest

# Open WebUI and SearXNG
# Pin a tested Open WebUI tag for reproducible upgrades.
OPENWEBUI_VERSION=main
ENABLE_SIGNUP=true
DEFAULT_USER_ROLE=pending
# Retrieved document chunks supplied as context, not web-search result count.
RAG_TOP_K=5
# Combine lexical and vector retrieval. Chunk settings affect new indexing;
# existing documents must be re-indexed to apply different split sizes.
ENABLE_RAG_HYBRID_SEARCH=true
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
# Image switches/settings may be overridden by saved Open WebUI admin settings.
# apply_qwen_images.py writes these values and bundled workflows into the database.
ENABLE_IMAGE_GENERATION=true
ENABLE_IMAGE_PROMPT_GENERATION=true
# Filenames must match installed ComfyUI assets and the downloader manifest.
IMAGE_GENERATION_MODEL=qwen-image-2.1-Q4_K_M.gguf
# Explicit width x height in pixels. More pixels/steps require more time/memory.
IMAGE_SIZE=1024x1024
IMAGE_STEPS=40
ENABLE_IMAGE_EDIT=true
IMAGE_EDIT_MODEL=qwen-image-2.1-Q4_K_M.gguf
# Open WebUI request size only; the edit workflow preserves the reference aspect
# ratio at ~1 MP. Adjust node 6 resolution in qwen-image-2.1-edit_image.json.
IMAGE_EDIT_SIZE=1024x1024
# Signup permits initial admin creation; new accounts require approval.
# Disable signup in Admin Settings after setup.
# Image prompts use llama-cpp-image via Open WebUI's external task model.
OPENWEBUI_HEALTH_START_PERIOD=15m
# Pin a tested SearXNG image tag when deploying reproducibly.
SEARXNG_VERSION=latest
# Limit results returned per search; the concurrency limit caps simultaneous
# search requests. Page loading has its own independent limit below.
WEB_SEARCH_RESULT_COUNT=6
WEB_SEARCH_CONCURRENT_REQUESTS=1
# Page downloads are limited independently of search queries.
WEB_LOADER_CONCURRENT_REQUESTS=3

# VRAM coordination between llama.cpp and ComfyUI
# Keep this internal URL unless deliberately using a different ComfyUI backend.
COMFYUI_URL=http://comfyui:8188
# Zero-based probe index; ensure it identifies the same GPU used for inference.
GPU_INDEX=0
# auto tries comfyui, amd-smi, rocm-smi, then sysfs; it prefers the last working
# source on subsequent checks. A named source disables fallback.
VRAM_SOURCE=auto
# Free-memory threshold in MiB (despite the MB name); 0 disables this criterion.
# This is a fixed reserve, not a prediction of the next image/model memory demand.
RESERVE_VRAM_MB=6000
# Optional used-memory percentage trigger (0..100); off disables it.
# Either enabled threshold can trigger pressure; both must recover to rearm.
VRAM_THRESHOLD_PCT=off
# Poll interval and retry cooldown in seconds; polling cannot serialize requests.
VRAM_CHECK_INTERVAL=1
VRAM_COOLDOWN_SECONDS=20
# Recovery margin above the free reserve / below the used-percent threshold.
# Separating trigger and recovery levels reduces repeated cleanup near the limit.
VRAM_HYSTERESIS_MB=1024
VRAM_HYSTERESIS_PCT=5
# Unload idle ComfyUI models after this many seconds; 0 disables idle unloading.
COMFYUI_IDLE_UNLOAD_SECONDS=5
# Permit pressure-driven escalation from cache cleanup to unloading ComfyUI
# models. Proactive idle unloading above is configured independently.
VRAM_AGGRESSIVE_FREE=true
VRAM_AGGRESSIVE_DELAY_SECONDS=8
# Per-request and local probe-command timeouts, in seconds.
VRAM_HTTP_TIMEOUT=2.5
VRAM_COMMAND_TIMEOUT=3
# Throttle repeated error messages; statistics interval controls summary logging.
VRAM_ERROR_LOG_INTERVAL=60
VRAM_STATS_INTERVAL=300
VRAM_DEBUG=false
