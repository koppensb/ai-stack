      "pluginVersion": "10.4.0",
      "targets": [
        { "editorMode": "code", "expr": "sum(rate(llamacpp:spec_decode_num_accepted_tokens_total{job=~\"$job\", instance=~\"$instance\"}[$__rate_interval])) / clamp_min(sum(rate(llamacpp:spec_decode_num_draft_tokens_total{job=~\"$job\", instance=~\"$instance\"}[$__rate_interval])), 1e-9)", "instant": false, "legendFormat": "Acceptance", "range": true, "refId": "A" }
      ],
      "title": "Speculative Decode Acceptance",
      "type": "gauge"
    },
    {
      "datasource": { "type": "prometheus", "uid": "$datasource" },
      "description": "Draft, accepted, and rejected speculative tokens per second. These series cover MTP, draft-model, EAGLE, and n-gram speculative decoding.",
      "fieldConfig": { "defaults": { "color": { "mode": "palette-classic" }, "custom": { "axisBorderShow": false, "axisCenteredZero": false, "axisColorMode": "text", "axisLabel": "Tokens / s", "axisPlacement": "auto", "barAlignment": 0, "drawStyle": "line", "fillOpacity": 15, "gradientMode": "none", "hideFrom": { "legend": false, "tooltip": false, "viz": false }, "insertNulls": false, "lineInterpolation": "smooth", "lineWidth": 2, "pointSize": 5, "scaleDistribution": { "type": "linear" }, "showPoints": "never", "spanNulls": false, "stacking": { "group": "A", "mode": "none" }, "thresholdsStyle": { "mode": "off" } }, "decimals": 2, "min": 0, "unit": "tps" }, "overrides": [] },
      "gridPos": {"h": 8, "w": 12, "x": 8, "y": 20},
      "id": 15,
      "options": { "legend": { "calcs": ["lastNotNull", "mean", "max"], "displayMode": "table", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [
        { "editorMode": "code", "expr": "sum(rate(llamacpp:spec_decode_num_draft_tokens_total{job=~\"$job\", instance=~\"$instance\"}[$__rate_interval]))", "legendFormat": "Drafted", "range": true, "refId": "A" },
        { "editorMode": "code", "expr": "sum(rate(llamacpp:spec_decode_num_accepted_tokens_total{job=~\"$job\", instance=~\"$instance\"}[$__rate_interval]))", "legendFormat": "Accepted", "range": true, "refId": "B" },
        { "editorMode": "code", "expr": "clamp_min(sum(rate(llamacpp:spec_decode_num_draft_tokens_total{job=~\"$job\", instance=~\"$instance\"}[$__rate_interval])) - sum(rate(llamacpp:spec_decode_num_accepted_tokens_total{job=~\"$job\", instance=~\"$instance\"}[$__rate_interval])), 0)", "legendFormat": "Rejected", "range": true, "refId": "C" }
      ],
      "title": "MTP / Speculative Token Rates",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "$datasource" },
      "description": "Verification frequency and average draft/accepted token counts per speculative decoding step.",
      "fieldConfig": { "defaults": { "color": { "mode": "palette-classic" }, "custom": { "axisBorderShow": false, "axisCenteredZero": false, "axisColorMode": "text", "axisLabel": "Per verification", "axisPlacement": "auto", "barAlignment": 0, "drawStyle": "line", "fillOpacity": 15, "gradientMode": "none", "hideFrom": { "legend": false, "tooltip": false, "viz": false }, "insertNulls": false, "lineInterpolation": "smooth", "lineWidth": 2, "pointSize": 5, "scaleDistribution": { "type": "linear" }, "showPoints": "never", "spanNulls": false, "stacking": { "group": "A", "mode": "none" }, "thresholdsStyle": { "mode": "off" } }, "decimals": 2, "min": 0, "unit": "short" }, "overrides": [] },
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 28},
      "id": 16,
      "options": { "legend": { "calcs": ["lastNotNull", "mean", "max"], "displayMode": "table", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [
        { "editorMode": "code", "expr": "sum(rate(llamacpp:spec_decode_num_drafts_total{job=~\"$job\", instance=~\"$instance\"}[$__rate_interval]))", "legendFormat": "Verifications / s", "range": true, "refId": "A" },
        { "editorMode": "code", "expr": "sum(rate(llamacpp:spec_decode_num_draft_tokens_total{job=~\"$job\", instance=~\"$instance\"}[$__rate_interval])) / clamp_min(sum(rate(llamacpp:spec_decode_num_drafts_total{job=~\"$job\", instance=~\"$instance\"}[$__rate_interval])), 1e-9)", "legendFormat": "Draft tokens / verification", "range": true, "refId": "B" },
        { "editorMode": "code", "expr": "sum(rate(llamacpp:spec_decode_num_accepted_tokens_total{job=~\"$job\", instance=~\"$instance\"}[$__rate_interval])) / clamp_min(sum(rate(llamacpp:spec_decode_num_drafts_total{job=~\"$job\", instance=~\"$instance\"}[$__rate_interval])), 1e-9)", "legendFormat": "Accepted tokens / verification", "range": true, "refId": "C" }
      ],
      "title": "MTP / Speculative Draft Efficiency",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "$datasource" },
      "description": "Accepted speculative tokens by draft position. Missing positions indicate that the build or active speculative method does not export this optional metric.",
      "fieldConfig": { "defaults": { "color": { "mode": "palette-classic" }, "custom": { "axisBorderShow": false, "axisCenteredZero": false, "axisColorMode": "text", "axisLabel": "Accepted tokens / s", "axisPlacement": "auto", "barAlignment": 0, "drawStyle": "line", "fillOpacity": 12, "gradientMode": "none", "hideFrom": { "legend": false, "tooltip": false, "viz": false }, "insertNulls": false, "lineInterpolation": "smooth", "lineWidth": 2, "pointSize": 5, "scaleDistribution": { "type": "linear" }, "showPoints": "never", "spanNulls": false, "stacking": { "group": "A", "mode": "none" }, "thresholdsStyle": { "mode": "off" } }, "decimals": 2, "min": 0, "unit": "tps" }, "overrides": [] },
      "gridPos": {"h": 8, "w": 24, "x": 0, "y": 36},
      "id": 17,
      "options": { "legend": { "calcs": ["lastNotNull", "mean", "max"], "displayMode": "table", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [
        { "editorMode": "code", "expr": "sum by (position) (rate(llamacpp:spec_decode_num_accepted_tokens_per_pos_total{job=~\"$job\", instance=~\"$instance\"}[$__rate_interval]))", "legendFormat": "Position {{position}}", "range": true, "refId": "A" }
      ],
      "title": "MTP / Speculative Acceptance by Draft Position",
      "type": "timeseries"
    }
